<Page x:Class="prac2.homePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:prac2"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="homePage" Background="White">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="75"></RowDefinition>
        </Grid.RowDefinitions>
        <TextBlock Text="Добро пожаловать!" Grid.Row="0" FontSize="25"
                   VerticalAlignment="Center" HorizontalAlignment="Center"></TextBlock>
        <Button x:Name="BackButton" Grid.Row="1" Content="Назад" Click="BackButton_Click"
                Height="50" Width="100" HorizontalAlignment="Left" Margin="75,0,0,0"></Button>
        <Button x:Name="Exit" Grid.Row="1" Content="Выход" Click="Exit_Click"
                 Height="50" Width="100" HorizontalAlignment="Right" Margin="0,0,75,0"></Button>
    </Grid>
</Page>
